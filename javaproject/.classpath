<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <classpathentry kind="src" path="src"/>
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
        <attributes>
            <attribute name="module" value="true"/>
        </attributes>
    </classpathentry>
	
	<!--Same imports as "extras" on https://depinfo.u-cergy.fr/~tliu/glp.php, CM4 -->
    <!--We mostly need jfreechart and log4j but we put them all here just in case -->
    <classpathentry kind="lib" path="src/lib/hamcrest-core-1.3.jar"/>
    <classpathentry kind="lib" path="src/lib/jcommon-1.0.23.jar"/>
    <classpathentry kind="lib" path="src/lib/jfreechart-1.0.19.jar"/>
    <classpathentry kind="lib" path="src/lib/jfreechart-1.0.19-experimental.jar"/>
    <classpathentry kind="lib" path="src/lib/jfreechart-1.0.19-swt.jar"/>
    <classpathentry kind="lib" path="src/lib/jfreesvg-2.0.jar"/>
    <classpathentry kind="lib" path="src/lib/junit-4.11.jar"/>
    <classpathentry kind="lib" path="src/lib/log4j-1.2.17.jar"/>
    <classpathentry kind="lib" path="src/lib/orsoncharts-1.4-eval-nofx.jar"/>
    <classpathentry kind="lib" path="src/lib/orsonpdf-1.6-eval.jar"/>
    <classpathentry kind="lib" path="src/lib/servlet.jar"/>
    <classpathentry kind="lib" path="src/lib/swtgraphics2d.jar"/>
    <classpathentry kind="output" path="bin"/>
</classpath>